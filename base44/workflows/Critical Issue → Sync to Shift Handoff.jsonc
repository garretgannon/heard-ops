{
  "name": "Critical Issue \u2192 Sync to Shift Handoff",
  "description": "When a critical issue is created or updated, immediately sync all open issues to today's Shift Handoff so the next manager sees it without waiting for the scheduled sync.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"critical\") or (.trigger.data.status == \"open\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Issue"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "critical_issue_sync_to_shift_handoff",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncIssuesToHandoff",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "syncIssuesToHandoff"
  }
}